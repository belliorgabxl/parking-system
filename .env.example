# Copy to .env.local and fill in.

# MongoDB connection string (Atlas or self-hosted) — REQUIRED
MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/?retryWrites=true&w=majority
# Database name (optional; overrides the one in the URI)
MONGODB_DB=parkswap

# Admin console (/admin). Use a long random value. Leave empty to disable.
ADMIN_KEY=change-me-to-a-long-random-string

# Secret for the deadline sweeper GET /api/cron/sweep (Authorization: Bearer <secret>). Call it every minute.
CRON_SECRET=change-me-too

# Demo deployment (class presentation / staging): enables simulation bots and on-screen OTP codes
# in a production build, and DISABLES withdrawals because all money is pretend. Never on for real users.
# DEMO_MODE=on

# OTP test mode: while there's no SMS provider, any 6-digit code logs in (dev / DEMO_MODE only,
# never in a real production deployment). "off" to require the real code.
# OTP_BYPASS=off

# Simulation bots (seeded spots, auto-match). Only ever active in `npm run dev` or DEMO_MODE. "off" to disable.
# PARKSWAP_SIMULATION=off
